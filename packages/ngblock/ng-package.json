{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/packages/ngblock",
  "assets": [
    {
      "glob": "styles.css",
      "input": ".generated",
      "output": "."
    },
    {
      "glob": "CHANGELOG.md",
      "input": ".",
