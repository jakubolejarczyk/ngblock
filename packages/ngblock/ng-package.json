    },
    {
      "glob": "PUBLISHING.md",
      "input": ".",
      "output": "."
    },
    {
      "glob": "LICENSE",
      "input": ".",
      "output": "."
    }
  ],
  "lib": {
    "entryFile": "src/index.ts"
  }
}
