{
  "name": "ngblock",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ngblock/src",
  "prefix": "ngb",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/ngblock/ng-package.json",
        "tsConfig": "packages/ngblock/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/ngblock/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "readyWhen": {
        "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
        "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
      },
      "options": {
        "port": 4400,
        "configDir": "packages/ngblock/.storybook",
        "browserTarget": "ngblock:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ngblock",
        "configDir": "packages/ngblock/.storybook",
        "browserTarget": "ngblock:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
